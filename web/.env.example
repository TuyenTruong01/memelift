# Select exactly one network for this frontend build: testnet or mainnet.
NEXT_PUBLIC_ARC_NETWORK=testnet
NEXT_PUBLIC_TESTNET_FACTORY_ADDRESS=
NEXT_PUBLIC_MAINNET_FACTORY_ADDRESS=

# Optional but recommended: enables WalletConnect QR for mobile/other wallets.
# Get a free project ID from WalletConnect Cloud.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

NEXT_PUBLIC_ARC_TESTNET_RPC=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_MAINNET_RPC=https://rpc.mainnet.arc.io

# Server-only Pinata JWT with the org:files:write permission. Never use NEXT_PUBLIC_ here.
PINATA_JWT=

# Optional public gateway used only to render ipfs:// token images. Defaults to Pinata's public gateway.
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
