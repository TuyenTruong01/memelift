# NEVER commit the real private key.
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Official Arc endpoints as of 2026-09-20.
ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# Arc USDC ERC-20 predeploy (6 decimals). Same address on testnet/mainnet.
ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_MAINNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Immutable recipient of the 0.95% protocol fee for each network.
# This is an address, never a private key.
ARC_TESTNET_PROTOCOL_TREASURY_ADDRESS=0xYOUR_TESTNET_TREASURY_ADDRESS
ARC_MAINNET_PROTOCOL_TREASURY_ADDRESS=0xYOUR_MAINNET_TREASURY_ADDRESS

# Virtual reserve sets the initial implied market cap.
# With this default, every launch starts near a $1,000 implied market cap.
VIRTUAL_USDC=1000
